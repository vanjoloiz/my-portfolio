extends baseEmail

block content
    p Hi #{username},
    p You've requested a password reset for your account. If you didn't make this request, feel free to ignore this email.
    p To reset your password, click on the button below:
    table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
        tbody
            tr
                td(align='left')
                    table(role='presentation', border='0', cellpadding='0', cellspacing='0')
                        tbody
                            tr
                                td
                                    a(href=`${passwordResetLink}`, target='_blank') Reset now
    p This link is valid for the next 1 hour. If you have any questions, contact me at vanjoloiz01@gmail.com.
    span Thanks 😊


